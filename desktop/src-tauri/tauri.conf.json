{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DefenseClaw Desktop",
  "version": "0.1.0",
  "identifier": "dev.defenseclaw.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DefenseClaw Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "resources/*",
      "../../cli/defenseclaw/agentrange_sidecar.py",
      "../../task/agentrange-adapter/*"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AI Agent security defense and range control plane",
    "longDescription": "DefenseClaw Desktop monitors local AI Agents, controls security policy, and orchestrates the AgentRange environment.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh",
        "displayLanguageSelector": false
      }
    }
  }
}
