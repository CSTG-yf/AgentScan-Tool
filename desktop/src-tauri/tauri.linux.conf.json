{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": [
      "resources/defenseclaw-gateway",
      "resources/tracebastion-sandbox",
      "resources/tracebastion-arena-scan",
      "resources/evaluation-static-v0.2.4.json",
      "resources/evaluation-runtime-action-v0.2.4.json",
      "../../NOTICE",
      "../../cli/ai_sandbox/PROVENANCE.md",
      "../../cli/defenseclaw/agentrange_sidecar.py",
      "../../task/agentrange-adapter/*",
      "linux/*",
      "README-Linux.md"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "policykit-1",
          "systemd",
          "fuse3"
        ]
      }
    }
  }
}
