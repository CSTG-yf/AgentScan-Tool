{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://defenseclaw.dev/schemas/desktop/process-guard-policy-v2.json",
  "title": "Windows Agent process guard policy",
  "type": "object",
  "required": ["version", "enabled", "mode", "agentNames", "rules", "fileGuard", "trace", "termination"],
  "properties": {
    "version": { "const": 2 },
    "enabled": { "type": "boolean" },
    "mode": { "enum": ["observe", "enforce"] },
    "agentNames": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+$" },
      "uniqueItems": true
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "enabled", "executable", "action"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
          "enabled": { "type": "boolean" },
          "executable": {
            "type": "string",
            "description": "Exact, case-insensitive executable basename; no paths, wildcards, or shell syntax.",
            "pattern": "^[A-Za-z0-9._+-]+(?:\\.exe)?$"
          },
          "action": { "enum": ["audit", "terminateAgentTree"] },
          "description": { "type": "string", "maxLength": 240 }
        },
        "additionalProperties": false
      }
    },
    "fileGuard": {
      "type": "object",
      "required": ["enabled", "auditRoots", "blacklist"],
      "properties": {
        "enabled": { "type": "boolean" },
        "auditRoots": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 3, "maxLength": 32767 },
          "uniqueItems": true
        },
        "blacklist": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["id", "enabled", "path", "matchKind", "access", "action"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
              "enabled": { "type": "boolean" },
              "path": { "type": "string", "minLength": 3, "maxLength": 32767 },
              "matchKind": { "enum": ["exact", "subtree"] },
              "access": {
                "type": "array",
                "minItems": 1,
                "items": { "enum": ["read", "write", "create", "delete", "any"] },
                "uniqueItems": true
              },
              "action": {
                "enum": ["returnEmptyContent", "terminateAgentTree"],
                "description": "returnEmptyContent is the current action. terminateAgentTree is accepted only to migrate saved v2 policies and is normalized on load."
              },
              "description": { "type": "string", "maxLength": 240 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "trace": {
      "type": "object",
      "required": ["enabled", "captureProcesses", "captureFileReads", "captureFileWrites", "captureFileCreates", "captureFileDeletes", "retentionDays", "maxDatabaseMb"],
      "properties": {
        "enabled": { "type": "boolean" },
        "captureProcesses": { "type": "boolean" },
        "captureFileReads": { "type": "boolean" },
        "captureFileWrites": { "type": "boolean" },
        "captureFileCreates": { "type": "boolean" },
        "captureFileDeletes": { "type": "boolean" },
        "retentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 },
        "maxDatabaseMb": { "type": "integer", "minimum": 16, "maximum": 10240 }
      },
      "additionalProperties": false
    },
    "termination": {
      "type": "object",
      "required": ["gracePeriodMs", "verifyProcessIdentity", "protectedProcessBehavior"],
      "properties": {
        "gracePeriodMs": { "type": "integer", "minimum": 0, "maximum": 30000 },
        "verifyProcessIdentity": { "const": true },
        "protectedProcessBehavior": { "const": "auditOnly" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
