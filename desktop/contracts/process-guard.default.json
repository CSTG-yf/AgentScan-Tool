{
  "version": 2,
  "enabled": false,
  "mode": "observe",
  "agentNames": [],
  "rules": [
    {
      "id": "command.grep",
      "enabled": false,
      "executable": "grep.exe",
      "action": "terminateAgentTree",
      "description": "示例规则：记录 grep.exe；仅在显式启用强制模式后终止所属 Agent 进程树。"
    },
    {
      "id": "command.curl",
      "enabled": false,
      "executable": "curl.exe",
      "action": "audit",
      "description": "观察 Agent 启动的 curl.exe 子进程，不执行终止。"
    },
    {
      "id": "command.powershell",
      "enabled": false,
      "executable": "powershell.exe",
      "action": "audit",
      "description": "观察传统 Windows PowerShell 子进程。"
    }
  ],
  "fileGuard": {
    "enabled": false,
    "auditRoots": [],
    "blacklist": []
  },
  "trace": {
    "enabled": true,
    "captureProcesses": true,
    "captureFileReads": true,
    "captureFileWrites": true,
    "captureFileCreates": true,
    "captureFileDeletes": true,
    "retentionDays": 30,
    "maxDatabaseMb": 256
  },
  "termination": {
    "gracePeriodMs": 1500,
    "verifyProcessIdentity": true,
    "protectedProcessBehavior": "auditOnly"
  }
}
