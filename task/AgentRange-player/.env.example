# Langflow（计划二接入）
LANGFLOW_AUTO_LOGIN=true
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=admin

# 身份配置风险：弱静态 JWT 密钥
JWT_SECRET=change-me-weak-secret
JWT_TTL_SECONDS=3600

# 服务账号松传递：默认保留 confused deputy 风险
OPSPILOT_PROPAGATION=service-account
OPSPILOT_SERVICE_TOKEN=svc-root-all-access

# Postgres
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot
POSTGRES_DB=opspilot
POSTGRES_HOST=postgres-customer
POSTGRES_PORT=5432

# DefenseClaw runtime integration. Leave API_BASE empty to run the original
# unprotected baseline. For Docker Desktop, expose/reach the host gateway and
# set the URL to its reachable address (commonly host.docker.internal).
DEFENSECLAW_API_BASE=
DEFENSECLAW_API_TOKEN=
DEFENSECLAW_FAIL_MODE=open
DEFENSECLAW_TIMEOUT_SECONDS=0.25
