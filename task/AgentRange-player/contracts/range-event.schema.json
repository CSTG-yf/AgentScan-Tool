{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentrange:range-event:v1",
  "title": "RangeEvent",
  "type": "object",
  "required": ["event_id", "instance_id", "trace_id", "timestamp", "stage", "asset_id", "raw_ref"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "instance_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "stage": {"enum": ["prompt", "skill", "llm_tool_call", "mcp_call", "tool_result", "final_response", "langflow_ingress", "network", "database", "decision", "degradation"]},
    "asset_id": {"type": "string", "minLength": 1},
    "direction": {"type": "string"},
    "tool": {"type": "string"},
    "payload": {"type": ["object", "array", "string", "number", "boolean", "null"]},
    "decision": {"$ref": "decision.schema.json"},
    "raw_ref": {"type": "string", "minLength": 1},
    "degradation_reason": {"type": "string"}
  },
  "additionalProperties": false
}
