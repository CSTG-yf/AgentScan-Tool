{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentrange:ground-truth:v1",
  "title": "RangeGroundTruth",
  "type": "object",
  "required": ["instance_id", "scenario_id", "label", "first_dangerous_action"],
  "properties": {
    "instance_id": {"type": "string", "minLength": 1},
    "scenario_id": {"enum": ["C1-A", "C1-B", "C2-A", "C2-B", "C2-C", "C2-D", "normal"]},
    "label": {"enum": ["malicious", "benign"]},
    "first_dangerous_action": {"type": ["string", "null"]},
    "expected_target": {"type": "string"}
  },
  "additionalProperties": false
}
